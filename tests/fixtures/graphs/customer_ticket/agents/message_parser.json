{
  "id": "message_parser",
  "name": "AC-01 消息解析器",
  "schema_version": 1,
  "model": {
    "provider": "deepseek",
    "name": "deepseek-chat",
    "base_url": null,
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.0,
    "max_tokens": 512,
    "context_window_tokens": 65536
  },
  "role_prompt_file": "prompt.md",
  "constraints_file": null,
  "tools": [],
  "input_mapping": {
    "user_message": "user_message"
  },
  "max_iterations": 4,
  "llm_timeout_ms": 60000,
  "llm_max_retries": 1,
  "node_timeout_ms": 60000
}
