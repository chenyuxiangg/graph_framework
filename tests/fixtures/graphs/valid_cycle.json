{
  "version": "1.0",
  "metadata": { "name": "gated-self-loop" },
  "entry_points": ["start"],
  "nodes": [
    { "id": "start", "type": "start", "inputs": [], "config": {} },
    {
      "id": "loop",
      "type": "python_node",
      "inputs": [
        { "name": "seed", "type": "string", "required": true },
        { "name": "again", "type": "boolean", "required": true }
      ],
      "config": { "module": "workers.cycle", "function": "looping" }
    },
    {
      "id": "done",
      "type": "end",
      "inputs": [{ "name": "result", "type": "any", "required": true }],
      "config": {}
    }
  ],
  "edges": [
    { "from": "start", "to_node": "loop", "to_input_port": "seed" },
    {
      "from": "loop",
      "to_node": "loop",
      "to_input_port": "again",
      "gate": { "function": "check_output", "params": { "path": "continue", "equals": true } }
    },
    { "from": "loop", "to_node": "done", "to_input_port": "result" }
  ]
}
