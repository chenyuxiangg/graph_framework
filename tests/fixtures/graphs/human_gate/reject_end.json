{
  "version": "1.0",
  "metadata": {
    "name": "human-gate-reject-end",
    "description": "W3a AC-16 b 终止变体：rejected settle 边 → end（无 defer；reject 后正常 Completed、无 attempt 重入）"
  },
  "entry_points": ["start"],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "inputs": [{ "name": "message", "type": "string", "required": true }],
      "config": {}
    },
    {
      "id": "prep",
      "type": "python_node",
      "inputs": [{ "name": "message", "type": "any", "required": true }],
      "config": { "module": "workers.echo", "function": "run" }
    },
    {
      "id": "reject_human",
      "type": "python_node",
      "inputs": [{ "name": "artifact", "type": "any", "required": true }],
      "config": { "module": "builtin", "function": "human" }
    },
    {
      "id": "done",
      "type": "end",
      "inputs": [{ "name": "result", "type": "any", "required": true }],
      "config": {}
    }
  ],
  "edges": [
    { "from": "start", "to_node": "prep", "to_input_port": "message" },
    { "from": "prep", "to_node": "reject_human", "to_input_port": "artifact" },
    {
      "from": "reject_human",
      "to_node": "done",
      "to_input_port": "result",
      "gate": {
        "function": "check_output",
        "params": { "path": "decision", "equals": "rejected" }
      }
    }
  ]
}
