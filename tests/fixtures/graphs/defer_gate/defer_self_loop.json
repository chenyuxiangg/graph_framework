{
  "version": "1.0",
  "metadata": {
    "name": "defer-self-loop",
    "description": "W2a AC-14 a/f：defer 自环返工（首轮 continue=true 重入，次轮 false 挂账 dormant）"
  },
  "entry_points": ["start"],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "inputs": [{ "name": "seed", "type": "string", "required": true }],
      "config": {}
    },
    {
      "id": "loop",
      "type": "python_node",
      "inputs": [
        { "name": "seed", "type": "any", "required": true },
        { "name": "again", "type": "any", "required": false }
      ],
      "trigger": "all",
      "config": { "module": "workers.cycle", "function": "looping" }
    }
  ],
  "edges": [
    { "from": "start", "to_node": "loop", "to_input_port": "seed" },
    {
      "from": "loop",
      "to_node": "loop",
      "to_input_port": "again",
      "gate": {
        "function": "check_output",
        "params": { "path": "continue", "equals": true }
      },
      "on_gate_false": "defer"
    }
  ]
}
